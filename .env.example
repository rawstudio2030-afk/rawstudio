# Copia este archivo a .env.local y rellena con los datos de tu proyecto.
# Panel de Supabase -> Project Settings -> API
#
# Ambas son publicas por diseño: viajan dentro del bundle del sitio. Lo que
# protege los datos es RLS en la base, no el secreto de estas llaves.
#
# NUNCA pongas aqui la service_role key: salta todas las politicas de RLS y
# cualquier variable con prefijo VITE_ termina publicada en el bundle.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY
